
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    // Absolute Super Admin Check
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'npatel012010@gmail.com' ||
        request.auth.uid == 'rSpqFXxlV4fxauxvGXNxYy2Njlx1'
      );
    }
    
    // Admin Check (Chapter Officers)
    function isAdmin() {
      return isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admin/$(request.auth.uid)));
    }

    // --- GLOBAL SUPER ADMIN BYPASS ---
    // This MUST come first and apply to all documents to prevent permission errors for the owner.
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // --- Collection Specific Rules ---

    match /admin/{userId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    match /members/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    match /service-hours/{hourId} {
      // Admins and Super Admins can list and manage everything
      allow list, get, write: if isAdmin();
      
      // Members can list and get their own hours
      // Firestore requires the query to filter by memberId for this to pass
      allow list: if isSignedIn() && resource.data.memberId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.memberId == request.auth.uid;
      
      // Members can create their own logs
      allow create: if isSignedIn() && request.resource.data.memberId == request.auth.uid;
      
      // Members can update/delete their own pending logs
      allow update, delete: if isSignedIn() && resource.data.memberId == request.auth.uid && resource.data.status == 'pending';
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteContent/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /photos/{photoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default catch-all for any missed collections
    match /{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
