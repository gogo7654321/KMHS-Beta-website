rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'npatel012010@gmail.com' ||
        request.auth.uid == 'rSpqFXxlV4fxauxvGXNxYy2Njlx1'
      );
    }
    
    function isAdmin() {
      return isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admin/$(request.auth.uid)));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Global Super Admin Bypass (Deployed: 2024-05-20T10:00:00Z) ---
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // --- Collection Specific Rules ---

    match /admin/{userId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isOwner(userId);
    }

    match /members/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /service-hours/{hourId} {
      // Super admins and Admins have full access.
      // Members can list their own hours by filtering on memberId.
      allow list: if isAdmin() || (
        isSignedIn() && 
        request.query.filters.size() > 0 && 
        request.query.filters[0].field == 'memberId' && 
        request.query.filters[0].op == '==' && 
        request.query.filters[0].value == request.auth.uid
      );
      
      allow get: if isAdmin() || (isSignedIn() && resource.data.memberId == request.auth.uid);
      
      allow create: if isSignedIn() && (isAdmin() || request.resource.data.memberId == request.auth.uid);
      
      allow update, delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteContent/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /photos/{photoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default catch-all for any other collections
    match /{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}