
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    // Absolute Super Admin Check (Global Bypass)
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'npatel012010@gmail.com' ||
        request.auth.uid == 'rSpqFXxlV4fxauxvGXNxYy2Njlx1'
      );
    }
    
    // Admin Check (Chapter Officers)
    function isAdmin() {
      return isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admin/$(request.auth.uid)));
    }

    // --- Global Super Admin Bypass ---
    // This allows the super admin to bypass all collection-level rules.
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // --- Collection Specific Rules ---

    match /admin/{userId} {
      // Anyone signed in can view leadership profiles for the Leadership page.
      allow read: if isSignedIn();
      // Only the user themselves or the super admin can edit an admin profile.
      allow write: if isSuperAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    match /members/{userId} {
      // Admins can see all member details. Members can see their own.
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      // Members can create/edit their own profiles; Admins have full control.
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    match /service-hours/{hourId} {
      // Admins can list and manage all service hours.
      allow read, write: if isAdmin();
      
      // Members can list their own hours (requires query filter matching uid).
      allow list: if isSignedIn() && (isAdmin() || resource.data.memberId == request.auth.uid);
      
      // Members can get their own specific documents.
      allow get: if isSignedIn() && (isAdmin() || resource.data.memberId == request.auth.uid);
      
      // Members can create their own logs.
      allow create: if isSignedIn() && (isAdmin() || request.resource.data.memberId == request.auth.uid);
      
      // Members can update/delete their own pending logs.
      allow update, delete: if isSignedIn() && (isAdmin() || (resource.data.memberId == request.auth.uid && resource.data.status == 'pending'));
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteContent/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /photos/{photoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default catch-all
    match /{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
