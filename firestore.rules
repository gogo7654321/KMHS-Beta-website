rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'npatel012010@gmail.com' ||
        request.auth.uid == 'rSpqFXxlV4fxauxvGXNxYy2Njlx1'
      );
    }
    
    function isAdmin() {
      return isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admin/$(request.auth.uid)));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Global Super Admin Bypass ---
    // This rule provides a absolute fallback for the super admin across all documents.
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // --- Collection Specific Rules ---

    match /admin/{userId} {
      allow get, list: if isSignedIn();
      allow write: if isSuperAdmin() || isOwner(userId);
    }

    match /members/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /service-hours/{hourId} {
      // Listing rules:
      // 1. Super admins and Admins can list everything.
      // 2. Members can list their own hours by filtering on memberId.
      allow list: if isSignedIn() && (
        isSuperAdmin() || 
        isAdmin() || 
        (request.query.filters.size() > 0 && 
         request.query.filters[0].field == 'memberId' && 
         request.query.filters[0].op == '==' && 
         request.query.filters[0].value == request.auth.uid)
      );
      
      allow get: if isSuperAdmin() || isAdmin() || (isSignedIn() && resource.data.memberId == request.auth.uid);
      
      // Creation: must set yourself as the owner unless you are an admin.
      allow create: if isSignedIn() && (isSuperAdmin() || isAdmin() || request.resource.data.memberId == request.auth.uid);
      
      allow update: if isSuperAdmin() || isAdmin();
      allow delete: if isSuperAdmin() || isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isAdmin();
    }

    match /siteContent/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isAdmin();
    }

    match /photos/{photoId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isAdmin();
    }

    // Default catch-all for any newly created collections
    match /{document=**} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isAdmin();
    }
  }
}