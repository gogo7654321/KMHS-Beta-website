
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    // Absolute Super Admin Check (UID and Email for redundancy)
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'npatel012010@gmail.com' ||
        request.auth.uid == 'rSpqFXxlV4fxauxvGXNxYy2Njlx1'
      );
    }
    
    // Admin Check (Chapter Officers)
    function isAdmin() {
      return isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admin/$(request.auth.uid)));
    }

    // --- GLOBAL SUPER ADMIN BYPASS ---
    // This is the highest priority rule. If this is true, all other rules are ignored.
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // --- Collection Specific Rules ---

    match /admin/{userId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    match /members/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    match /service-hours/{hourId} {
      // Explicitly allow listing and getting for Super Admins, Admins, and the specific Owner
      allow read: if isSuperAdmin() || isAdmin() || (isSignedIn() && resource.data.memberId == request.auth.uid);
      
      // Allow creation if the user is an admin or is creating their own record
      allow create: if isSuperAdmin() || isAdmin() || (isSignedIn() && request.resource.data.memberId == request.auth.uid);
      
      // Allow updates/deletes if admin or if owner and still pending
      allow update, delete: if isSuperAdmin() || isAdmin() || (isSignedIn() && resource.data.memberId == request.auth.uid && resource.data.status == 'pending');
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteContent/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /photos/{photoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default catch-all for any missed collections
    match /{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
