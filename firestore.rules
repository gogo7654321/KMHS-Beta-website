
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'npatel012010@gmail.com';
    }
    
    function isAdmin() {
      return isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admin/$(request.auth.uid)));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Explicitly allow Super Admin full access to everything as a root rule
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    match /admin/{userId} {
      allow get, list: if isSignedIn();
      allow write: if isSuperAdmin() || isOwner(userId);
    }

    match /members/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /service-hours/{hourId} {
      // Allow listing:
      // 1. If the user is an admin or super admin.
      // 2. If a member is querying ONLY their own hours (filtered by memberId == auth.uid).
      allow list: if isAdmin() || (isSignedIn() && request.query.filters.size() > 0 && request.query.filters[0].field == 'memberId' && request.query.filters[0].op == '==' && request.query.filters[0].value == request.auth.uid);
      
      allow get: if isAdmin() || (isSignedIn() && resource.data.memberId == request.auth.uid);
      
      // Allow creation if the user is setting themselves as the owner of the record.
      allow create: if isSignedIn() && request.resource.data.memberId == request.auth.uid;
      
      // Updates and deletions are reserved for leadership review or cleanup.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteContent/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /photos/{photoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default catch-all for other collections
    match /{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
