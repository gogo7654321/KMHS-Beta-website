
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    // Absolute Super Admin Check (Root Bypass)
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'npatel012010@gmail.com' ||
        request.auth.uid == 'rSpqFXxlV4fxauxvGXNxYy2Njlx1'
      );
    }
    
    // Admin Check (Chapter Officers)
    function isAdmin() {
      return isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admin/$(request.auth.uid)));
    }

    // --- Collection Specific Rules ---

    match /admin/{userId} {
      // Leadership profiles MUST be public so guests can see the team.
      allow read: if true;
      allow write: if isSuperAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    match /members/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    match /service-hours/{hourId} {
      // Priority Super Admin bypass
      allow read, write: if isSuperAdmin();

      // Explicitly handle list/query operations for relevant users
      allow list: if isAdmin() || (isSignedIn() && request.auth.uid != null);
      
      allow get: if isAdmin() || (isSignedIn() && resource.data.memberId == request.auth.uid);
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.memberId == request.auth.uid);
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.memberId == request.auth.uid && resource.data.status == 'pending');
    }

    match /blogs/{blogId} {
      // Blogs are public for SEO and AdSense
      allow read, list: if true;
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      // Events are public for student information
      allow read, list: if true;
      allow write: if isAdmin();
    }

    match /siteContent/{docId} {
      // General site text like gallery settings or home announcements
      allow read, list: if true;
      allow write: if isAdmin();
    }

    match /photos/{photoId} {
      // Gallery photos are public
      allow read, list: if true;
      allow write: if isAdmin();
    }

    // Default catch-all (Must remain below prioritized collection matches)
    match /{document=**} {
      allow read: if isSignedIn() || isSuperAdmin();
      allow write: if isAdmin() || isSuperAdmin();
    }
  }
}
