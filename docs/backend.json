
{
  "entities": {
    "Event": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Event",
      "type": "object",
      "description": "Represents a Beta Club event.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the event."
        },
        "title": {
          "type": "string",
          "description": "The title of the event."
        },
        "description": {
          "type": "string",
          "description": "A detailed description of the event."
        },
        "dateTime": {
          "type": "string",
          "description": "The date and time of the event.",
          "format": "date-time"
        },
        "endTime": {
          "type": "string",
          "description": "The end time of the event (optional).",
          "format": "time"
        },
        "location": {
          "type": "string",
          "description": "The location of the event."
        },
        "types": {
          "type": "array",
          "description": "List of categories the event belongs to.",
          "items": {
            "type": "string"
          }
        },
        "rsvpEnabled": {
          "type": "boolean",
          "description": "Indicates if RSVP is enabled for the event."
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "dateTime",
        "location",
        "types",
        "rsvpEnabled"
      ]
    },
    "EventType": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "EventType",
      "type": "object",
      "description": "Represents the type of an event.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the event type."
        },
        "name": {
          "type": "string",
          "description": "The name of the event type (e.g., Meeting, Service Project)."
        },
        "description": {
          "type": "string",
          "description": "A description of the event type."
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ]
    },
    "ServiceHour": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ServiceHour",
      "type": "object",
      "description": "Represents service hours contributed by a member.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the service hour record."
        },
        "memberId": {
          "type": "string",
          "description": "Reference to Member. (Relationship: Member 1:N ServiceHour)"
        },
        "eventId": {
          "type": "string",
          "description": "Reference to Event. (Relationship: Event 1:N ServiceHour)"
        },
        "hours": {
          "type": "number",
          "description": "The number of service hours contributed."
        },
        "date": {
          "type": "string",
          "description": "The date the service hours were performed.",
          "format": "date-time"
        },
        "description": {
          "type": "string",
          "description": "Description of the service activity"
        }
      },
      "required": [
        "id",
        "memberId",
        "eventId",
        "hours",
        "date",
        "description"
      ]
    },
    "Member": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Member",
      "type": "object",
      "description": "Represents a Beta Club member.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the member."
        },
        "firstName": {
          "type": "string",
          "description": "The first name of the member."
        },
        "lastName": {
          "type": "string",
          "description": "The last name of the member."
        },
        "grade": {
          "type": "number",
          "description": "The grade level of the member."
        },
        "email": {
          "type": "string",
          "description": "The email address of the member.",
          "format": "email"
        },
        "positionId": {
          "type": "string",
          "description": "Reference to Position. (Relationship: Position 1:N Member)"
        }
      },
      "required": [
        "id",
        "firstName",
        "lastName",
        "grade",
        "email",
        "positionId"
      ]
    },
    "Admin": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Admin",
      "type": "object",
      "description": "Represents an administrator user.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the admin (matches Firebase Auth UID)."
        },
        "firstName": {
          "type": "string",
          "description": "The first name of the admin."
        },
        "lastName": {
          "type": "string",
          "description": "The last name of the admin."
        },
        "grade": {
          "type": "number",
          "description": "The grade level of the admin."
        },
        "email": {
          "type": "string",
          "description": "The email address of the admin.",
          "format": "email"
        },
        "position": {
          "type": "string",
          "description": "The position of the admin (e.g., President, Faculty Advisor)."
        },
        "bio": {
          "type": "string",
          "description": "A short biography of the administrator."
        },
        "imageUrl": {
          "type": "string",
          "description": "URL for the administrator's profile picture.",
          "format": "uri"
        },
        "order": {
          "type": "number",
          "description": "Display order on the leadership page."
        },
        "personalUrl": {
          "type": "string",
          "description": "A personal website or social media URL for the administrator.",
          "format": "uri"
        }
      },
      "required": [
        "id",
        "firstName",
        "lastName",
        "grade",
        "email",
        "position"
      ]
    },
    "Position": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Position",
      "type": "object",
      "description": "Represents a leadership position within the Beta Club.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the position."
        },
        "title": {
          "type": "string",
          "description": "The title of the position (e.g., President, Vice President)."
        },
        "description": {
          "type": "string",
          "description": "A description of the responsibilities of the position."
        }
      },
      "required": [
        "id",
        "title",
        "description"
      ]
    },
    "Photo": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Photo",
      "type": "object",
      "description": "Represents a photo in the gallery.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the photo."
        },
        "title": {
          "type": "string",
          "description": "The title of the photo."
        },
        "description": {
          "type": "string",
          "description": "A description of the photo."
        },
        "category": {
          "type": "string",
          "description": "The category of the photo.",
          "enum": [
            "Service",
            "Academics",
            "Social",
            "Ceremonies"
          ]
        },
        "imageUrl": {
          "type": "string",
          "description": "The URL of the photo, hosted in Firebase Storage.",
          "format": "uri"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when the photo was added.",
          "format": "date-time"
        },
        "names": {
          "type": "array",
          "description": "A list of names of people featured in the photo.",
          "items": {
            "type": "string"
          }
        },
        "order": {
          "type": "number",
          "description": "Display order in the gallery."
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "category",
        "imageUrl",
        "createdAt"
      ]
    },
    "Announcement": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Announcement",
      "type": "object",
      "description": "Represents an announcement created by the administration.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the announcement."
        },
        "title": {
          "type": "string",
          "description": "The title of the announcement."
        },
        "content": {
          "type": "string",
          "description": "The content of the announcement."
        },
        "createdAt": {
          "type": "string",
          "description": "The date and time the announcement was created.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "title",
        "content",
        "createdAt"
      ]
    },
    "HomePageContent": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Home Page Content",
      "type": "object",
      "description": "Singleton document for dynamic content on the home page.",
      "properties": {
        "announcementText": {
          "type": "string",
          "description": "The text for the main announcement bar on the home page."
        }
      },
      "required": [
        "announcementText"
      ]
    },
    "GallerySettings": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Gallery Settings",
      "type": "object",
      "description": "Singleton document for dynamic settings for the photo gallery, controlled by Super Admins.",
      "properties": {
        "isTitleRequired": {
          "type": "boolean",
          "description": "If true, the title field is mandatory for photo uploads."
        },
        "isDescriptionRequired": {
          "type": "boolean",
          "description": "If true, the description field is mandatory for photo uploads."
        },
        "isNamesRequired": {
          "type": "boolean",
          "description": "If true, the names field is mandatory for photo uploads."
        }
      },
      "required": []
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/admin/{userId}",
        "definition": {
          "entityName": "Admin",
          "schema": {
            "$ref": "#/backend/entities/Admin"
          },
          "description": "Collection of admin users. Existence of a document with a user's ID grants admin privileges.",
          "params": [
            {
              "name": "userId",
              "description": "The Firebase Auth UID of the admin user."
            }
          ]
        }
      },
      {
        "path": "/events/{eventId}",
        "definition": {
          "entityName": "Event",
          "schema": {
            "$ref": "#/backend/entities/Event"
          },
          "description": "Collection of events.",
          "params": [
            {
              "name": "eventId",
              "description": "Unique identifier for the event."
            }
          ]
        }
      }
    ]
  }
}
