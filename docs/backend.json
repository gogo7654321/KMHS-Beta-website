
{
  "entities": {
    "Event": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Event",
      "type": "object",
      "description": "Represents a Beta Club event.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the event."
        },
        "title": {
          "type": "string",
          "description": "The title of the event."
        },
        "description": {
          "type": "string",
          "description": "A detailed description of the event."
        },
        "dateTime": {
          "type": "string",
          "description": "The date and time of the event.",
          "format": "date-time"
        },
        "endTime": {
          "type": "string",
          "description": "The end time of the event (optional).",
          "format": "time"
        },
        "location": {
          "type": "string",
          "description": "The location of the event."
        },
        "types": {
          "type": "array",
          "description": "List of categories the event belongs to.",
          "items": {
            "type": "string"
          }
        },
        "rsvpEnabled": {
          "type": "boolean",
          "description": "Indicates if RSVP is enabled for the event."
        },
        "albumId": {
          "type": "string",
          "description": "Optional reference to a gallery album."
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "dateTime",
        "location",
        "types",
        "rsvpEnabled"
      ]
    },
    "Album": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Album",
      "type": "object",
      "description": "A group of photos from an event or activity.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "coverImageUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "order": { "type": "number" }
      },
      "required": ["id", "title", "createdAt"]
    },
    "Photo": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Photo",
      "type": "object",
      "description": "A single photo in the gallery.",
      "properties": {
        "id": { "type": "string" },
        "albumId": { "type": "string" },
        "imageUrl": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "order": { "type": "number" }
      },
      "required": ["id", "albumId", "imageUrl", "createdAt"]
    },
    "ServiceHour": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ServiceHour",
      "type": "object",
      "description": "Represents service hours contributed by a member.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the service hour record."
        },
        "memberId": {
          "type": "string",
          "description": "Reference to Member UID."
        },
        "eventName": {
          "type": "string",
          "description": "Name of the event or activity."
        },
        "hours": {
          "type": "number",
          "description": "The number of service hours contributed."
        },
        "date": {
          "type": "string",
          "description": "The date the service hours were performed.",
          "format": "date"
        },
        "description": {
          "type": "string",
          "description": "Description of the service activity."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "description": "The approval status of the hours."
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "memberId",
        "eventName",
        "hours",
        "date",
        "status"
      ]
    },
    "Member": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Member",
      "type": "object",
      "description": "Represents a Beta Club member.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the member (UID)."
        },
        "memberId": {
          "type": "string",
          "description": "Random 5-digit member identifier."
        },
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
        "grade": {
          "type": "number"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "totalHours": {
          "type": "number",
          "description": "Cached total of approved service hours."
        }
      },
      "required": [
        "id",
        "memberId",
        "firstName",
        "lastName",
        "grade",
        "email"
      ]
    },
    "Admin": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Admin",
      "type": "object",
      "description": "Represents an administrator user.",
      "properties": {
        "id": {
          "type": "string"
        },
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "position": {
          "type": "string"
        },
        "grade": {
          "type": "number"
        }
      }
    },
    "BlogPost": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "BlogPost",
      "type": "object",
      "description": "Represents a chapter blog article.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "imageUrl": { "type": "string" },
        "imageCaption": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "authorName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["draft", "published"] }
      },
      "required": ["id", "title", "content", "authorName", "createdAt", "status"]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/admin/{userId}",
        "definition": {
          "entityName": "Admin",
          "schema": {
            "$ref": "#/backend/entities/Admin"
          },
          "description": "Collection of admin users."
        }
      },
      {
        "path": "/members/{userId}",
        "definition": {
          "entityName": "Member",
          "schema": {
            "$ref": "#/backend/entities/Member"
          },
          "description": "Collection of club members."
        }
      },
      {
        "path": "/service-hours/{hourId}",
        "definition": {
          "entityName": "ServiceHour",
          "schema": {
            "$ref": "#/backend/entities/ServiceHour"
          },
          "description": "Service hour log entries."
        }
      },
      {
        "path": "/blogs/{blogId}",
        "definition": {
          "entityName": "BlogPost",
          "schema": {
            "$ref": "#/backend/entities/BlogPost"
          },
          "description": "Chapter blog articles."
        }
      },
      {
        "path": "/albums/{albumId}",
        "definition": {
          "entityName": "Album",
          "schema": {
            "$ref": "#/backend/entities/Album"
          },
          "description": "Gallery albums."
        }
      },
      {
        "path": "/photos/{photoId}",
        "definition": {
          "entityName": "Photo",
          "schema": {
            "$ref": "#/backend/entities/Photo"
          },
          "description": "Gallery photos."
        }
      }
    ]
  }
}
