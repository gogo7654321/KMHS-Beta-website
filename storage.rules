
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'npatel012010@gmail.com' ||
        request.auth.uid == 'rSpqFXxlV4fxauxvGXNxYy2Njlx1'
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (request.auth != null && request.auth.token.email != null);
    }

    match /admin-avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if (request.auth != null && request.auth.uid == userId) || isSuperAdmin();
    }

    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blog-images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
